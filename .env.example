# Exemple de variables d'entorn per a buscafeina
# Copia este fichero como .env (en la carpeta donde ejecutes la CLI) y rellena
# lo que uses. .env está en .gitignore: NUNCA subas claves al repositorio.
# Las variables ya presentes en el entorno tienen prioridad sobre el .env.

# --- API oficial de InfoJobs (opcional, resultados más fiables con filtros) ---
# Regístrate gratis en https://developer.infojobs.net
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# --- IA compatible con OpenAI (solo si proveidor_ia = "openai" en config.json) ---
OPENAI_API_KEY=
