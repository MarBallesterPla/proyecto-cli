# Exemple de variables d'entorn per a buscafeina
# Còpia este fitxer com a .env (a la carpeta on executes la CLI) i ompli el
# que fas servir. .env està en .gitignore: MAI puges claus al repositori.
# Les variables ja presents en l'entorn tenen prioritat sobre el .env.

# --- API oficial d'InfoJobs (opcional, resultats més fiables amb filtres) ---
# Registra-te gratis en https://developer.infojobs.net
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# --- IA compatible amb OpenAI (només si proveidor_ia = "openai" a config.json) ---
OPENAI_API_KEY=
